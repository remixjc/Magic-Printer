{
  "name": "magic-printer",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first cross-platform printing workspace",
  "license": "PolyForm-Noncommercial-1.0.0",
  "author": "remixjc",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @magic-printer/desktop dev",
